# Public, read-only Sanity settings used by the Vite app
VITE_SANITY_PROJECT_ID=your-project-id
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2025-01-01

# Optional. Defaults to /api/join (the included Vercel function).
VITE_JOIN_ENDPOINT=/api/join

# Server-only settings for api/join.js. Never prefix the token with VITE_.
